# Optional: configure MongoDB Atlas or a replica-set MongoDB deployment for persistence.
# Without this value the API uses in-memory sample data.
MONGODB_URI=
MONGODB_DATABASE=clinicconnect
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
